{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yifengling0.github.io/VintagePomeloPro-Compatibility/schemas/game.schema.json",
  "title": "VintagePomeloPro Game Compatibility Record",
  "description": "One YAML file describes one game and all of its compatibility reports. GAME and REPORT are separate concepts; historical reports must never be overwritten.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "slug",
    "name",
    "release_date",
    "release_year",
    "developer",
    "genres",
    "platforms",
    "metadata_confidence",
    "created_at",
    "updated_at",
    "reports"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Fixed by this schema revision."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable unique game identifier (equals slug)."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "URL slug. Stable once published."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical English game title."
    },
    "name_zh": {
      "type": "string",
      "description": "Canonical Chinese game title."
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Alternative names (including regional and fan names)."
    },
    "release_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date YYYY-MM-DD."
    },
    "release_year": {
      "type": "integer",
      "minimum": 1970,
      "maximum": 2100,
      "description": "Must match release_date year."
    },
    "developer": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "publisher": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "genres": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "Free-form genre tags; the UI groups known tags into a filter."
    },
    "platforms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "external_ids": {
      "type": "object",
      "properties": {
        "steam": { "type": ["string", "null"] },
        "igdb": { "type": ["string", "null"] },
        "gog": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "metadata_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "id": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "metadata_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/report" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "report": {
      "type": "object",
      "required": [
        "report_id",
        "source",
        "tested_at",
        "status"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Unique across the whole dataset (e.g. issue-351 or user-slug-0001)."
        },
        "source": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["github_issue", "manual", "maintainer", "ci"] },
            "issue": { "type": ["integer", "null"] },
            "user": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "tested_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "winehua_version": {
          "type": ["string", "null"]
        },
        "device": {
          "type": "object",
          "properties": {
            "model": { "type": ["string", "null"] },
            "soc": { "type": ["string", "null"] },
            "gpu": { "type": ["string", "null"] },
            "os": { "type": ["string", "null"] },
            "os_version": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "renderer": {
          "type": "object",
          "required": ["backend"],
          "properties": {
            "backend": {
              "type": "string",
              "enum": ["virgl", "dxvk", "vkd3d", "wined3d", "native_opengl", "other"]
            },
            "version": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "graphics_api": {
          "type": "object",
          "properties": {
            "api": {
              "type": ["string", "null"],
              "enum": ["d3d9", "d3d10", "d3d11", "d3d12", "opengl", "vulkan", "other", null]
            }
          },
          "additionalProperties": true
        },
        "architecture": {
          "type": "object",
          "properties": {
            "game": { "type": ["string", "null"], "enum": ["x86", "x64", "arm", "arm64", null] },
            "wine": { "type": ["string", "null"], "enum": ["x86", "x64", "arm", "arm64", null] }
          },
          "additionalProperties": true
        },
        "status": {
          "type": "string",
          "enum": ["perfect", "playable", "minor_issues", "major_issues", "broken", "unknown"]
        },
        "performance": {
          "type": "object",
          "properties": {
            "fps_avg": { "type": ["number", "null"] },
            "fps_min": { "type": ["number", "null"] },
            "fps_max": { "type": ["number", "null"] },
            "resolution": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "symptoms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "workarounds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": ["string", "null"]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "screenshots": { "type": "array", "items": { "type": "string" } },
            "logs": { "type": "array", "items": { "type": "string" } },
            "videos": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
